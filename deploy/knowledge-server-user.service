[Unit]
Description=Local multi-library knowledge server
Documentation=file:///home/stallieman/projects/knowledge-server/README.md

[Service]
Type=simple
WorkingDirectory=/home/stallieman/projects/knowledge-server
ExecStartPre=/usr/bin/test -x /home/stallieman/projects/knowledge-server/.venv/bin/knowledge-server
ExecStart=/home/stallieman/projects/knowledge-server/.venv/bin/knowledge-server serve --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
KillSignal=SIGINT
Nice=10
IOSchedulingClass=idle
TasksMax=64
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=KNOWLEDGE_SERVER_DB=/home/stallieman/projects/knowledge-server/data/knowledge.db
Environment=KNOWLEDGE_SERVER_TRANSCRIBER_PATH=/home/stallieman/projects/local-meeting-transcriber
Environment=KNOWLEDGE_SERVER_VIDEO_UPLOADS=/home/stallieman/projects/knowledge-server/data/video-uploads
NoNewPrivileges=yes
PrivateTmp=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077

[Install]
WantedBy=default.target
