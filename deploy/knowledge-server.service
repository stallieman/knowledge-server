[Unit]
Description=Local multi-library knowledge server
Documentation=file:///home/stallieman/projects/knowledge-server/README.md
Wants=network-online.target ollama.service
After=network-online.target ollama.service

[Service]
Type=simple
User=stallieman
Group=stallieman
WorkingDirectory=/home/stallieman/projects/knowledge-server
ExecStartPre=/usr/bin/test -x /home/stallieman/projects/knowledge-server/.venv/bin/knowledge-server
ExecStart=/home/stallieman/projects/knowledge-server/.venv/bin/knowledge-server serve --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
KillSignal=SIGINT

# Keep the always-on web process quiet and low priority while idle.
Nice=10
CPUWeight=20
IOWeight=20
IOSchedulingClass=idle
TasksMax=64
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=KNOWLEDGE_SERVER_DB=/home/stallieman/projects/knowledge-server/data/knowledge.db

# The API does not need elevated privileges or direct device access.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/stallieman/projects/knowledge-server/data
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077

[Install]
WantedBy=multi-user.target
