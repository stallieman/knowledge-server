[Unit]
Description=Incremental knowledge library indexer

[Service]
Type=oneshot
WorkingDirectory=/home/stallieman/projects/knowledge-server
ExecStart=/home/stallieman/projects/knowledge-server/.venv/bin/knowledge-server ingest-all --source-root /home/stallieman/projects/knowledge-server/data/import --git-sources /home/stallieman/projects/knowledge-server/config/git-sources.json
Nice=15
IOSchedulingClass=idle
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=KNOWLEDGE_SERVER_DB=/home/stallieman/projects/knowledge-server/data/knowledge.db
NoNewPrivileges=yes
PrivateTmp=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077
